<?xml version='1.0' encoding='utf-8'?>
<widget id="es.angelgf.angeldice" version="1.1.11" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>AngelDice</name>
    <description>Angel Dice. Repite la secuencia de colores.</description>
    <author email="angelgf@gmail.com" href="">Angel Galan Fernandez</author>
    <content src="index.html" />
    <allow-intent href="https://*/*" />
    <preference name="orientation" value="portrait" />
    <preference name="android-minSdkVersion" value="24" />
    <preference name="android-targetSdkVersion" value="36" />
    <preference name="AndroidWindowSplashScreenAnimatedIcon" value="res/icon/android/AngelDiceSplash.png" />
    <preference name="GradlePluginKotlinEnabled" value="true" />
    <preference name="GradlePluginKotlinVersion" value="2.3.0" />
    <plugin name="cordova-plugin-device" spec="^3.0.0" />
    <platform name="android">
        <allow-intent href="market:*" />
        <!-- Todos salen de pwa/favicon.svg con pruebas/iconos.html. src es el icono de
             siempre; foreground y background, el adaptativo (Android 8 o posterior). -->
        <icon density="ldpi" src="res/icon/android/icono-36.png" foreground="res/icon/android/adaptativo-frente.png" background="res/icon/android/adaptativo-fondo.png" />
        <icon density="mdpi" src="res/icon/android/icono-48.png" foreground="res/icon/android/adaptativo-frente.png" background="res/icon/android/adaptativo-fondo.png" />
        <icon density="hdpi" src="res/icon/android/icono-72.png" foreground="res/icon/android/adaptativo-frente.png" background="res/icon/android/adaptativo-fondo.png" />
        <icon density="xhdpi" src="res/icon/android/icono-96.png" foreground="res/icon/android/adaptativo-frente.png" background="res/icon/android/adaptativo-fondo.png" />
        <icon density="xxhdpi" src="res/icon/android/icono-144.png" foreground="res/icon/android/adaptativo-frente.png" background="res/icon/android/adaptativo-fondo.png" />
        <icon density="xxxhdpi" src="res/icon/android/icono-192.png" foreground="res/icon/android/adaptativo-frente.png" background="res/icon/android/adaptativo-fondo.png" />
    </platform>
    <platform name="ios">
        <allow-intent href="itms:*" />
        <allow-intent href="itms-apps:*" />
    </platform>
    <engine name="android" spec="^13.0.0" />
    <hook src="hooks/after_prepare/set_immersive.js" type="after_prepare" />
    <hook src="hooks/after_prepare/back_to_background.js" type="after_prepare" />
    <hook src="hooks/copy-android-config.js" type="before_build" />
</widget>
